FROM php:8.4.27-fpm

# Stop builds before publication when upstream PHP still lacks the October 2026 RCE fixes.
# CVE-2026-109618 / CVE-2026-109619; unsupported PHP branches fail closed.
RUN php -r '$minimum = ["8.2" => "8.2.35", "8.3" => "8.3.36", "8.4" => "8.4.27", "8.5" => "8.5.12"]; $series = PHP_MAJOR_VERSION . "." . PHP_MINOR_VERSION; if (!isset($minimum[$series]) || version_compare(PHP_VERSION, $minimum[$series], "<")) { fwrite(STDERR, "Unpatched or unsupported PHP runtime: " . PHP_VERSION . PHP_EOL); exit(1); }'


RUN apt-get update \
    && apt-get install -y \
        busybox-static \
        curl \
        git \
        jq \
        libcurl4-openssl-dev \
        libfreetype6-dev \
        libicu-dev \
        libjpeg62-turbo-dev \
        libonig-dev \
        libpng-dev \
        libxml2-dev \
        libzip-dev \
        locales \
        procps \
        unzip \
    && mkdir -p /var/spool/cron/crontabs \
    && echo '*/5 * * * * php -f /var/www/html/src/cron.php' > /var/spool/cron/crontabs/www-data \
    && sed -i -e 's/# en_US.UTF-8 UTF-8/en_US.UTF-8 UTF-8/' /etc/locale.gen \
    && locale-gen \
    && rm -rf /var/lib/apt/lists/*

ENV LANG=en_US.UTF-8
ENV LANGUAGE=en_US:en
ENV LC_ALL=en_US.UTF-8

# Install PHP extensions and Composer
ADD https://github.com/mlocati/docker-php-extension-installer/releases/latest/download/install-php-extensions /usr/local/bin/
RUN chmod uga+x /usr/local/bin/install-php-extensions \
    && sync \
    && install-php-extensions \
        apcu \
        bcmath \
        curl \
        exif \
        fileinfo \
        filter \
        gd \
        gettext \
        iconv \
        intl \
        mbstring \
        mysqli \
        opcache \
        pdo_mysql \
        session \
        sodium \
        xdebug \
        xml \
        zip \
        zlib \
        @composer \
    && rm /usr/local/bin/install-php-extensions \
    && chown -R www-data /var/www

# Install NVM + Node 24 to match upstream requirements
RUN curl -o- https://raw.githubusercontent.com/nvm-sh/nvm/master/install.sh | bash \
    && export NVM_DIR="/root/.nvm" \
    && . "$NVM_DIR/nvm.sh" \
    && nvm install 24 \
    && nvm alias default 24

COPY config/php/* /usr/local/etc/php/conf.d/
COPY scripts/* /var/www/scripts/

VOLUME /var/www/html

WORKDIR /var/www/html

ENTRYPOINT ["bash", "/var/www/scripts/entrypoint.sh"]
CMD ["php-fpm"]