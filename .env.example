TZ=CET

# Docker image selector for PHP Dockerfile suffix.
PHP_VERSION=84

# ChurchCRM source repository and ref (branch, tag, or commit SHA)
CHURCHCRM_REPOSITORY=https://github.com/ChurchCRM/CRM
CHURCHCRM_VERSION=master

# Host/volume permission mapping
HOST_UID=1000
HOST_GID=1000

# MariaDB
MARIADB_ROOT_PASSWORD=root
MARIADB_DATABASE=churchcrm
MARIADB_USER=churchcrm
MARIADB_PASSWORD=churchcrm
MARIADB_HOST=mariadb

# HTTP and base URL
HTTP_PORT=80
BASE_URL=http://localhost/
ROOT_PATH=
INTERNAL_DOMAIN=nginx
IGNORE_HTTPS_CHECK=true
RUN_FRONTEND_BUILD=false

# Frontend dev server (optional)
WEBPACK_PORT=3000

# Mailpit UI + SMTP
MAILPIT_PORT=8025
MAILPIT_SMTP_PORT=1025

# Xdebug (disabled by default)
XDEBUG_MODE=off
XDEBUG_CONFIG=client_host=host.docker.internal client_port=9003 start_with_request=yes

# ChurchCRM 2FA secret fallback for Config.php template
TFA_SECRET=ChangeThisToASecureRandomStringBeforeUse

# Locale inside container
LANGUAGE=pt_BR.UTF-8